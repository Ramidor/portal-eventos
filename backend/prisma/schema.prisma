generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  MUSICA
  DEPORTE
  ARTE
  TECNOLOGIA
  GASTRONOMIA
  EDUCACION
  NEGOCIOS
  OTRO
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  password               String
  role                   Role      @default(USER)
  emailVerified          Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  resetToken             String?
  resetTokenExpiry       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizedEvents  Event[]      @relation("UserToOrganizer")
  enrollments      Enrollment[]
  messages         Message[]
  ratingsGiven     Rating[]     @relation("RaterToRatings")
  ratingsReceived  Rating[]     @relation("CreatorToRatings")
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  date         DateTime
  location     String
  latitude     Float?
  longitude    Float?
  image        String?
  category     Category @default(OTRO)
  maxAttendees Int?
  creatorId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator     User         @relation("UserToOrganizer", fields: [creatorId], references: [id])
  enrollments Enrollment[]
  messages    Message[]
  ratings     Rating[]

  @@index([date])
  @@index([category])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int      // 1-5
  comment   String?
  raterId   Int
  creatorId Int
  eventId   Int
  createdAt DateTime @default(now())

  rater   User  @relation("RaterToRatings",   fields: [raterId],   references: [id], onDelete: Cascade)
  creator User  @relation("CreatorToRatings", fields: [creatorId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId],  references: [id],    onDelete: Cascade)

  @@unique([raterId, eventId])
}
