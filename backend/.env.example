# ── Base de datos ─────────────────────────────────────────────────────────────
# Railway proporciona esta variable automáticamente al añadir el servicio PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/portal_eventos"

# ── Autenticación ─────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET="genera-un-string-aleatorio-seguro-de-32-bytes"

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL del cliente web sin barra final. Usada para CORS y para los enlaces de email.
CLIENT_URL="http://localhost:5173"

# ── Correo electrónico (Resend) ───────────────────────────────────────────────
# Clave de API de Resend (https://resend.com). Comienza siempre por "re_".
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Credenciales del panel de Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
